#!/bin/bash
# Build a Heroku app slug using the Heroku (classic) buildpack interface.
# <https://devcenter.heroku.com/articles/buildpack-api>
# 
# The slug is used (via CI) to deploy the canary and dev apps (servers).
# (It is also used for the production server by promoting the canary one.)
# Review apps _do not use this slug_ - they are built on Heroku and use
# config from `app.json`. **It is important to keep the buildpacks in app.json
# in-sync with the ones used here.** In the future we could also build
# review app slugs using this script, but that requires more engineering,
# including stopping / removing the review app.          - james 2026
#
# XXX TODO: Switch to the Heroku Cloud Native buildpacks (CNB) once they're
# well-supported by Heroku's platform (or if we move off Heroku).  The use of
# CNB to pack an app into an image is much simpler (and more comprehensive)
# than Heroku's classic buildpacks: most of this program below would vanish.
# Supporting CNB has long been on Heroku's roadmap and although it's still in
# preview¹, it's been getting recent attention.
#   -trs, 13 May 2024
#
# ¹ <https://blog.heroku.com/heroku-cloud-native-buildpacks>
#
set -euo pipefail

cd "$(dirname "$0")/.."

echo "---> Hello from $0"
echo "     Source directory is $PWD"
echo "     Build  directory is $PWD/build"
echo
echo "---> Removing any previous build/app/"
rm -rf build/app/

echo
echo "---> Ensuring build dirs exist"
mkdir -vp build/{app,cache,env}

echo
echo "---> Copying source to build/app/"
# Don't use `git archive` because it excludes uncommitted (but unignored) files
# in the working tree.  Pass thru tar so that it handles directory creation for
# us.
git ls-files --cached --others --exclude-standard -z \
  | tar --create  --file - --null --files-from - \
  | tar --extract --file - --verbose -C build/app/

echo
echo "---> Setting buildpack env vars from source"
export SOURCE_VERSION SOURCE_DESCRIPTION
echo "     SOURCE_VERSION=${SOURCE_VERSION:=$(git describe --always --dirty --abbrev=40)}"
echo "     SOURCE_DESCRIPTION=${SOURCE_DESCRIPTION:=$(git log -1 --format=%s)}"

# Buildpacks to apply, in order. Each entry is "<name> <git-org>/<git-repo>"
# (name is used for printing helpful messages, it's not part of the final slug)
# P.S. check each repo can resolve a tag name associated with the latest release (via the curl command below)
buildpacks=(
  "puppeteer jontewks/puppeteer-heroku-buildpack" # installs the shared libraries Puppeteer's bundled Chrome (browser) needs
  "nodejs    heroku/heroku-buildpack-nodejs"
)

if [[ ! -d build/pack ]]; then
    # install (clone) each buildpack into a numbered subdirectory inside `build/pack/`
    i=0
    for entry in "${buildpacks[@]}"; do
        read -r buildpack_name buildpack_git_org_repo <<<"$entry"
        latest_tag=$(curl -fsSL https://api.github.com/repos/${buildpack_git_org_repo}/releases/latest | jq -r .tag_name)
        dir=build/pack/$(printf '%02d' "$i")-"$buildpack_name"
        echo "---> Cloning ${buildpack_git_org_repo} ${latest_tag} into ${dir}"
        # advice.detachedHead=false silences the (expected) detached-HEAD notice from cloning a tag
        git -c advice.detachedHead=false clone --depth 1 https://github.com/${buildpack_git_org_repo} ${dir} --branch ${latest_tag}
        i=$((i + 1))
    done
else
  echo
  echo "---> Using buildpacks in build/pack/"
  echo "     NOTE: this script assumes these are up-to-date & complete"
fi

echo
echo "---> Buildpack versions"
for dir in build/pack/*/; do
  echo "     $dir -> $(git -C "$dir" describe --always --dirty)"
done

echo
echo "---> Running buildpacks"
# build/pack is mounted read-write (not read-only) because a buildpack's bin/compile may write
# an "export" file into its own directory; see the sourcing step below.
# The in-container script is fed via `bash -s` and a QUOTED heredoc
# (<<'DOCKER_SCRIPT') rather than `bash -c '...'`.  The quoted delimiter stops
# the host shell from expanding $, ${...} and $(...) (so they reach the
# container's bash verbatim), and, unlike a single-quoted -c argument, the body
# may contain apostrophes freely — an apostrophe in a comment or string would
# otherwise silently terminate the -c string and drop everything after it.
docker run \
  --rm --interactive \
  --user $(id -u):$(id -g) \
  --volume "$(realpath build/app)":/build/app:rw \
  --volume "$(realpath build/pack)":/build/pack:rw \
  --volume "$(realpath build/cache)":/build/cache:rw \
  --volume "$(realpath build/env)":/build/env:ro \
  --env HOME=/tmp \
  --env STACK=heroku-24 \
  --env SOURCE_VERSION \
  --env SOURCE_DESCRIPTION \
  --env NODE_MODULES_CACHE=false \
  heroku/heroku:24-build bash -s <<'DOCKER_SCRIPT'
    set -euo pipefail
    shopt -s nullglob
    packs=(/build/pack/*/)
    (( ${#packs[@]} )) || { echo "ERROR: no buildpacks found in /build/pack" >&2; exit 1; }
    # Run each buildpack's compile in listed (lexical) order.  For each, source
    # its "export" file if present so build-time env vars (e.g. LD_LIBRARY_PATH)
    # propagate to subsequent buildpacks.  We don't run the buildpacks' bin/detect
    # scripts because our list of buildpacks to apply is explicit.
    for pack in "${packs[@]}"; do
      echo "---> Running ${pack}bin/compile"
      "${pack}bin/compile" /build/app /build/cache /build/env
      if [[ -f "${pack}export" ]]; then
        echo "---> Sourcing ${pack}export"
        source "${pack}export"
      fi
    done
DOCKER_SCRIPT

# The remaining steps are part of the unpublished (but somewhat documented)
# "slug compiler"¹ for classic Heroku buildpacks.
#
# The Procfile conversion is a published part of Heroku's upcoming "Cloud
# Native" buildpacks, though, so nab the per-line regex from there.²
#
# ¹ <https://devcenter.heroku.com/articles/slug-compiler>
# ² <https://github.com/heroku/buildpacks-procfile/blob/df64135f/src/procfile.rs#L42-L44>
echo
echo "---> Converting Procfile to JSON"
jq --slurp --raw-input '
    split("\n")
  | map(capture("^[[:space:]]*(?<key>[a-zA-Z0-9_-]+):?\\s+(?<value>.*)[[:space:]]*"))
  | from_entries
' < build/app/Procfile | tee build/app/Procfile.json

echo
echo "---> Writing build/app/.heroku/BASH_ENV for use with BASH_ENV"
tee build/app/.heroku/BASH_ENV <<<'
  for f in "$(dirname "$BASH_SOURCE")"/../.profile.d/*; do
      # On Heroku dynos, the slug is at /app and HOME=/app, but that is not
      # true elsewhere and HOME often points somewhere completely separate.
      # Make the .profile.d/ scripts portable when using this BASH_ENV script.
      HOME="$(realpath "$(dirname "$BASH_SOURCE")"/..)" source "$f"
  done
'

# <https://devcenter.heroku.com/articles/platform-api-deploying-slugs>
echo
echo "---> Packing build/app/ into build/slug.tar.gz"
tar --create --gzip --file build/slug.tar.gz -C build/ ./app/
sha256sum build/slug.tar.gz > build/slug.tar.gz.sha256sum
du -h --si -s build/app/ build/slug.tar.gz

# <https://devcenter.heroku.com/articles/platform-api-reference#slug-create>
echo
echo "---> Generating build/slug.json metadata for slug creation"
jq \
  --null-input \
  --argjson procfile "$(<build/app/Procfile.json)" \
  --arg checksum "$(awk '{print "SHA256:" $1}' build/slug.tar.gz.sha256sum)" \
  '{
    "stack": "heroku-24",
    "commit": $ENV.SOURCE_VERSION,
    "commit_description": $ENV.SOURCE_DESCRIPTION,
    "process_types": $procfile,
    "checksum": $checksum,
  }' | tee build/slug.json
